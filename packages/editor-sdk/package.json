    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.1.5",
    "vite-plugin-dts": "4.5.0"
  },
  "scripts": {
    "build": "vite build",
    "lint": "echo \"no lint config yet\" && exit 0",
    "typecheck": "tsc --noEmit",
