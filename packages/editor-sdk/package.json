        "require": "./dist/editor-sdk.cjs"
      },
      "./style.css": "./dist/editor-sdk.css"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.11",
